{
  "_comment": "LLM 语音控制配置. 真 API Key 写在 voice_llm_config.local.json (已 gitignore), 或通过 --api-key 传入.",

  "api_key": "",

  "mimo": {
    "base_url": "https://api.xiaomimimo.com/v1",
    "model": "mimo-v2.5",
    "max_tokens": 1024,
    "thinking_disabled": true,
    "timeout_s": 15
  },

  "tts": {
    "model": "mimo-v2.5-tts",
    "voice": "冰糖",
    "instruction": "用中文自然地说，活泼温暖，语速正常。"
  },

  "record": {
    "sample_rate": 16000,
    "output_sample_rate": 8000,
    "max_duration_s": 10.0,
    "min_duration_s": 0.3
  },

  "gesture_defaults": {
    "duration": 0.8,
    "speed": null
  },

  "vad": {
    "threshold": 0.6,
    "min_speech_duration": 0.35,
    "min_silence_duration": 2.0,
    "max_speech_duration": 10.0
  },

  "doubao": {
    "_comment": "豆包端到端实时语音大模型-全双工版本 (Seeduplex). 真 key 写在 voice_llm_config.local.json 的 doubao.api_key, 或 --api-key / 环境变量 DOUBAO_API_KEY.",
    "api_key": "",
    "ws_url": "wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue",
    "model": "1.2.6.1",
    "voice": "",
    "speed": 0,
    "loudness": 0,
    "audio_input_format": "pcm",
    "audio_output_format": "pcm_s16le",
    "chunk_ms": 20,
    "prebuffer_chunks": 3,
    "connect_timeout_s": 10,
    "ping_interval_s": 20,
    "reconnect_max_retries": 5,
    "backoff_base_s": 1.0,
    "backoff_max_s": 8.0
  }
}
