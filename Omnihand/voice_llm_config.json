{
  "_comment": "LLM 语音控制配置. 真 API Key 写在 voice_llm_config.local.json (已 gitignore), 或通过 --api-key 传入.",

  "api_key": "",

  "mimo": {
    "base_url": "https://api.xiaomimimo.com/v1",
    "model": "mimo-v2.5",
    "max_tokens": 1024,
    "thinking_disabled": true,
    "timeout_s": 15
  },

  "tts": {
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "+10%",
